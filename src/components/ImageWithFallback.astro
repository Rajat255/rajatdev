---
/**
 * ImageWithFallback.astro — shared image error-fallback primitive.
 *
 * - The image renders inside a slot whose dimensions are reserved up front from
 *   an explicit aspect ratio, so a load failure causes NO layout shift.
 * - On error the broken `<img>` is hidden (never a broken-image icon) and a
 *   styled alt-text box, sized to the same reserved slot, is revealed in place.
 * - The swap is driven by an inline `onerror` handler that only toggles a data
 *   attribute, so it needs zero client JS and can never fail to run.
 * - Passing `lazy` defers the real `src`/`srcset` behind `data-src`/`data-srcset`
 *   for the shared one-viewport IntersectionObserver loader, with a `<noscript>`
 *   native-lazy fallback so the media still loads without JS.
 */
interface Props {
  src: string;
  /** Descriptive alt text; also surfaced in place on load failure. */
  alt: string;
  width?: number;
  height?: number;
  /** Explicit CSS aspect ratio (e.g. "3 / 2"). Overrides width/height. */
  aspectRatio?: string;
  class?: string;
  imgClass?: string;
  sizes?: string;
  srcset?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  objectFit?: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down';
  /** Opt into the shared one-viewport lazy loader. */
  lazy?: boolean;
}

const {
  src,
  alt,
  width,
  height,
  aspectRatio,
  class: className,
  imgClass,
  sizes,
  srcset,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  objectFit = 'cover',
  lazy = false,
} = Astro.props;

// Reserve the slot's dimensions up front. Prefer an explicit aspectRatio, else
// derive one from width/height.
const resolvedAspectRatio =
  aspectRatio ?? (width && height ? `${width} / ${height}` : undefined);

const rootStyle = resolvedAspectRatio ? `aspect-ratio:${resolvedAspectRatio}` : undefined;
---

<div class:list={['iwf', className]} data-image-fallback style={rootStyle}>
  <img
    class:list={['iwf__img', imgClass]}
    src={lazy ? undefined : src}
    data-src={lazy ? src : undefined}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    srcset={lazy ? undefined : srcset}
    data-srcset={lazy ? srcset : undefined}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    style={`object-fit:${objectFit}`}
    data-image-fallback-img
    data-lazy={lazy ? true : undefined}
    onerror="this.closest('[data-image-fallback]')?.setAttribute('data-errored','true')"
  />

  {
    lazy && (
      <noscript>
        <img
          class:list={['iwf__img', imgClass]}
          src={src}
          alt={alt}
          width={width}
          height={height}
          sizes={sizes}
          srcset={srcset}
          loading="lazy"
          decoding={decoding}
          style={`object-fit:${objectFit}`}
        />
      </noscript>
    )
  }

  {/* Styled alt-text box sized to the same reserved slot. Hidden until error. */}
  <div class="iwf__fallback" data-image-fallback-text>
    <p class="iwf__fallback-text">{alt}</p>
  </div>
</div>

<style>
  .iwf {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    /* Faint colourless wash so the reserved slot is never empty while loading,
       without painting a tint over the glass surface behind it. */
    background-color: rgb(255 255 255 / 0.03);
  }

  .iwf__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .iwf[data-errored='true'] .iwf__img {
    display: none;
  }

  /* The fallback occupies the exact reserved slot, so swapping in preserves the
     surrounding layout dimensions. */
  .iwf__fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    text-align: center;
    /* Colourless so it matches the glass surface it sits on. */
    background-color: rgb(255 255 255 / 0.05);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .iwf[data-errored='true'] .iwf__fallback {
    display: flex;
  }

  .iwf__fallback-text {
    max-width: 90%;
    color: rgb(var(--muted-foreground));
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
