---
import { getIconMarkup, isFilledIcon, type IconName } from '../lib/icons';

/**
 * Icon.astro — renders one glyph from the shared icon registry.
 *
 * The registry itself lives in `src/lib/icons.ts` (Astro frontmatter cannot
 * export types for other modules to import), so `IconName` is type-checked at
 * every call site and a bad name is a build error.
 *
 * Icons are decorative by default (`aria-hidden`). Pass a `title` only when the
 * icon is the sole carrier of meaning; otherwise label the parent control.
 */
interface Props {
  name: IconName;
  /** Rendered size in px (applied to both width and height). */
  size?: number;
  class?: string;
  /** Accessible name. When set, the icon is exposed as a labelled image. */
  title?: string;
  /** Stroke width; the default suits 16-24px rendering. Ignored by brand marks. */
  strokeWidth?: number;
}

const { name, size = 20, class: className, title, strokeWidth = 1.75 } = Astro.props;

const filled = isFilledIcon(name);
const markup = getIconMarkup(name);
---

{
  title ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={filled ? 'currentColor' : 'none'}
      stroke={filled ? undefined : 'currentColor'}
      stroke-width={filled ? undefined : strokeWidth}
      stroke-linecap={filled ? undefined : 'round'}
      stroke-linejoin={filled ? undefined : 'round'}
      class:list={['shrink-0', className]}
      role="img"
      aria-label={title}
      set:html={markup}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={filled ? 'currentColor' : 'none'}
      stroke={filled ? undefined : 'currentColor'}
      stroke-width={filled ? undefined : strokeWidth}
      stroke-linecap={filled ? undefined : 'round'}
      stroke-linejoin={filled ? undefined : 'round'}
      class:list={['shrink-0', className]}
      aria-hidden="true"
      focusable="false"
      set:html={markup}
    />
  )
}
