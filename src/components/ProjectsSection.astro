---
import { orderedProjects } from '../content/projects';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
import { profile } from '../content/profile';

/**
 * ProjectsSection.astro — the Projects section body.
 *
 * Renders the validated projects as a responsive grid: one column on mobile, two
 * from the `sm` breakpoint up. Featured projects are ordered first by the content
 * layer. Each card owns its own media/tags/links layout; this is a pure
 * composition wrapper.
 *
 * Motion: each card is scroll-revealed once per page load through the shared
 * AnimationEngine. Cards render in their final, fully visible state by default,
 * so content is never hidden without JS, and both a reduced-motion preference
 * and any reveal failure resolve to the final visible state (handled centrally
 * inside the engine).
 */
const githubProfile = profile.socials.find((s) => s.name === 'GitHub');
---

<div class="mt-6">
  <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2" role="list">
    {
      orderedProjects.map((project) => (
        <li class="h-full" data-project-reveal>
          <ProjectCard
            title={project.title}
            description={project.description}
            dates={project.dates}
            tags={project.tags}
            links={project.links}
            image={project.image}
          />
        </li>
      ))
    }
  </ul>

  {
    githubProfile && (
      <p class="mt-6 text-center">
        <a
          href={githubProfile.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center gap-2 rounded-full glass glass-hover px-5 py-2 text-sm font-medium text-foreground hover:text-primary"
        >
          <Icon name="github" size={16} />
          View all projects on GitHub
          <Icon name="external" size={14} />
        </a>
      </p>
    )
  }
</div>

<script>
  import { getAnimationEngine } from '../lib/animation/AnimationEngine';

  // Reveal timing: start within 200ms, complete within 1000ms. The engine clamps
  // defensively to the same bounds.
  const REVEAL_START_DELAY_MS = 60;
  const REVEAL_DURATION_MS = 650;

  if (typeof window !== 'undefined') {
    const engine = getAnimationEngine();
    const cards = document.querySelectorAll<HTMLElement>('[data-project-reveal]');

    cards.forEach((card) => {
      // Reveal each card once per load, ending fully visible. Reduced-motion and
      // failure fallbacks are handled centrally inside the engine.
      engine.reveal(card, {
        startDelayMs: REVEAL_START_DELAY_MS,
        durationMs: REVEAL_DURATION_MS,
        motion: {
          kind: 'translate',
          startDelayMs: REVEAL_START_DELAY_MS,
          durationMs: REVEAL_DURATION_MS,
        },
      });
    });
  }
</script>
