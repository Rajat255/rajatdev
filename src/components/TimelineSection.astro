---
import { timeline } from '../content/timeline';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

/**
 * TimelineSection.astro — the Timeline section body.
 *
 * A single chronological rail with the spine pinned to the left at every
 * viewport and one column of cards beside it.
 *
 * This replaced an alternating two-column layout, which broke down in the
 * `max-w-3xl` page container for two reasons: each card only got ~21rem, which
 * is too narrow for three lines of prose, and pairs of entries shared a grid row,
 * so every row stretched to its taller card and left a ragged hole under the
 * shorter one. Mirroring also forced right-aligned body copy on one side, which
 * is hard to read at this length. One column fixes all three and reads the same
 * from 360px to 2560px.
 *
 * Each entry is scroll-revealed once per load through the shared AnimationEngine
 * and renders in its final visible state by default, so nothing is hidden
 * without JS.
 */

/** Maps the content-layer icon enum onto the shared icon set. */
const ICON_MAP: Record<string, IconName> = {
  award: 'award',
  briefcase: 'briefcase',
  graduation: 'graduation',
  rocket: 'rocket',
  code: 'code',
  pin: 'pin',
  sparkle: 'sparkle',
};
---

<div class="tl mt-6">
  <ol class="tl-list" role="list">
    {
      timeline.map((entry) => (
        <li class="tl-item" data-timeline-reveal>
          <span class="tl-dot" aria-hidden="true" />
          <article class="tl-card glass glass-hover">
            <p class="tl-card-date">{entry.date}</p>
            <h3 class="tl-card-title">
              <Icon name={ICON_MAP[entry.icon] ?? 'sparkle'} size={16} class="text-primary" />
              <span>{entry.title}</span>
            </h3>
            <p class="tl-card-body">{entry.description}</p>
            {entry.flair && <p class="tl-card-flair">{entry.flair}</p>}
          </article>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .tl-list {
    position: relative;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The vertical spine. Inset top and bottom so it starts and ends at the first
     and last dot rather than overshooting past the cards. */
  .tl-list::before {
    content: '';
    position: absolute;
    top: 1.125rem;
    bottom: 1rem;
    left: 0.3125rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(
      to bottom,
      rgb(var(--primary) / 0.8),
      rgb(var(--accent) / 0.5)
    );
  }

  .tl-item {
    position: relative;
    padding-left: 1.75rem;
    min-width: 0;
  }

  /* Sits on the spine, vertically centred on the date line of its card. */
  .tl-dot {
    position: absolute;
    top: 0.8125rem;
    left: 0.3125rem;
    width: 0.625rem;
    height: 0.625rem;
    transform: translateX(calc(-50% + 1px));
    border-radius: 9999px;
    background: rgb(var(--primary));
    box-shadow: 0 0 0 3px rgb(var(--background));
    z-index: 1;
  }

  /* Surface (fill, border, blur, shadow) comes from the shared `.glass` utility;
     only geometry is set here. */
  .tl-card {
    border-radius: 0.75rem;
    padding: 0.75rem 1rem 0.875rem;
  }

  /* Date leads as an eyebrow above the title: it is the thing being scanned when
     you read a timeline, and putting it first stops the tiny grey line from
     looking like an orphan under the heading. */
  .tl-card-date {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  .tl-card-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.1875rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    color: rgb(var(--card-foreground));
  }

  /* Keeps the glyph on the first line of a wrapping title instead of letting
     `align-items: baseline` drag it down. */
  .tl-card-title :global(svg) {
    flex: none;
    transform: translateY(0.125rem);
  }

  .tl-card-body {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: rgb(var(--muted-foreground));
  }

  /* The aside. Set apart by a hairline rule rather than a box, so it reads as a
     footnote to the entry and not a second paragraph. */
  .tl-card-flair {
    margin-top: 0.5rem;
    padding-left: 0.5rem;
    border-left: 2px solid rgb(var(--accent) / 0.55);
    font-size: 0.75rem;
    font-style: italic;
    line-height: 1.5;
    /* Muted rather than accent-coloured: the rule already carries the accent, and
       12px italic in orange would sit near the AA floor on the light theme. */
    color: rgb(var(--muted-foreground) / 0.9);
  }

  @media (min-width: 640px) {
    .tl-item {
      padding-left: 2.25rem;
    }

    .tl-card {
      padding: 0.875rem 1.125rem 1rem;
    }

    /* Follows the card's extra top padding so the dot stays level with the date. */
    .tl-dot {
      top: 0.9375rem;
    }
  }
</style>

<script>
  import { getAnimationEngine } from '../lib/animation/AnimationEngine';

  const REVEAL_START_DELAY_MS = 50;
  const REVEAL_DURATION_MS = 600;

  if (typeof window !== 'undefined') {
    const engine = getAnimationEngine();
    document
      .querySelectorAll<HTMLElement>('[data-timeline-reveal]')
      .forEach((entry) => {
        engine.reveal(entry, {
          startDelayMs: REVEAL_START_DELAY_MS,
          durationMs: REVEAL_DURATION_MS,
          motion: {
            kind: 'translate',
            startDelayMs: REVEAL_START_DELAY_MS,
            durationMs: REVEAL_DURATION_MS,
          },
        });
      });
  }
</script>
