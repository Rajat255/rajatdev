---
import type { Project, ProjectLinkType } from '../content/projects';
import ImageWithFallback from './ImageWithFallback.astro';

/**
 * ProjectCard.astro — a single project card.
 *
 * Anatomy: an optional top media area, a title + date header, a description, a
 * wrapped row of tag badges, and a footer row of link badges.
 *
 * The card is a flex column so cards in a grid row share equal height and the
 * footer link row always sits at the bottom. When `image` is absent a gradient
 * placeholder with a folder glyph is shown, so a missing image reads as
 * intentional rather than broken.
 *
 * Media uses the shared `ImageWithFallback` primitive, which reserves the slot's
 * aspect ratio up front (no layout shift on failure) and opts into the
 * one-viewport lazy loader.
 */
interface Props {
  title: Project['title'];
  description: Project['description'];
  dates: Project['dates'];
  tags: Project['tags'];
  links?: Project['links'];
  image?: Project['image'];
}

const { title, description, dates, tags, links, image } = Astro.props;

const projectLinks = links ?? [];
const hasLinks = projectLinks.length > 0;

/** Inline glyph markup per link type (24x24, currentColor stroke). */
const LINK_ICONS: Record<ProjectLinkType, string> = {
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  website:
    '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  demo: '<polygon points="5 3 19 12 5 21 5 3"/>',
  article:
    '<path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  other:
    '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>',
};

/** Default label per link type, overridable per-link via `label`. */
const LINK_LABELS: Record<ProjectLinkType, string> = {
  github: 'Code',
  website: 'Website',
  demo: 'Demo',
  article: 'Writeup',
  other: 'Link',
};
---

<article
  class="glass glass-hover flex h-full flex-col overflow-hidden rounded-xl text-foreground hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  {
    image ? (
      <ImageWithFallback
        src={image}
        alt={`${title} preview`}
        aspectRatio="16 / 9"
        objectFit="contain"
        lazy
      />
    ) : (
      /* Neutral placeholder: a faint white wash rather than a tinted gradient,
         so a card without media still reads as glass. */
      <div
        class="flex aspect-video w-full items-center justify-center bg-white/[0.03]"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground/50"
        >
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
        </svg>
      </div>
    )
  }

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="space-y-1">
      <h3 class="text-lg font-semibold leading-snug tracking-tight">{title}</h3>
      <p class="text-xs text-muted-foreground">{dates}</p>
    </div>

    <p class="text-sm leading-relaxed text-muted-foreground">{description}</p>

    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5 pt-1" role="list">
          {tags.map((tag) => (
            <li>
              <span class="inline-flex items-center rounded-md border border-white/10 bg-white/[0.05] px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                {tag}
              </span>
            </li>
          ))}
        </ul>
      )
    }

    {
      hasLinks && (
        <div class="mt-auto flex flex-wrap gap-2 pt-3">
          {projectLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[34px] items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.06] px-2.5 py-1 text-xs font-medium text-foreground transition-colors hover:border-primary/60 hover:bg-white/[0.1] hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={LINK_ICONS[link.type]}
              />
              <span>{link.label ?? LINK_LABELS[link.type]}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
