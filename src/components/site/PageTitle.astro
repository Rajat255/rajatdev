---
/**
 * PageTitle.astro — the centred title at the top of an inner page, in the
 * same spaced crimson capitals as the front page, then an optional short
 * introduction. No tagline under the title: the title says what the page is.
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="pb-4 pt-14 text-center sm:pt-20">
  <h1 class="block pl-[0.18em] font-serif text-3xl font-semibold uppercase leading-tight tracking-[0.18em] text-accent sm:text-4xl">
    {title}
  </h1>
  {
    Astro.slots.has('default') && (
      <div class="mt-8 text-left">
        <slot />
      </div>
    )
  }
</div>
