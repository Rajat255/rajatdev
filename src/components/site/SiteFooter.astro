---
import ThemeToggle from '../ThemeToggle.tsx';
import FinisBanner from '../ornaments/FinisBanner.astro';
import { SITE_CONFIG, showcaseIsPublic } from '../../config/site';

/**
 * SiteFooter.astro — the end of every page: the Finis banner, where the site
 * is hosted, the copyright line, a row of links, and the dark mode switch.
 * `/showcase` is linked only when `SITE_CONFIG.showShowcaseInNav` is true.
 */
const { colophon, contact } = SITE_CONFIG;

const links = [
  { label: 'email', href: `mailto:${contact.email}`, external: false },
  { label: 'github', href: contact.github, external: true },
  { label: 'linkedin', href: contact.linkedin, external: true },
  { label: 'résumé', href: contact.resume, external: false },
  { label: 'rss', href: '/rss.xml', external: false },
  { label: 'colophon', href: '/colophon/', external: false },
  ...(showcaseIsPublic() ? [{ label: 'showcase', href: '/showcase/', external: false }] : []),
];
---

<footer class="mt-24 pb-14 text-center">
  <FinisBanner text={colophon.finis} />
  <p class="mt-4 italic text-ink">{colophon.hosting}</p>
  <p class="mt-1 text-base text-muted">{colophon.copyright}</p>

  <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-5 text-base" role="list">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="link inline-block py-2 text-muted"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li class="text-base">
      <ThemeToggle client:idle />
    </li>
  </ul>
</footer>
