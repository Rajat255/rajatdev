---
import { profile } from '../content/profile';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

/**
 * SocialLinks.astro — a horizontal row of social / contact icon links.
 *
 * Reads `profile.socials` and renders each entry as an icon link, choosing a
 * glyph from the social's `name`. Icons paint in `currentColor` so they inherit
 * the link color and flip correctly between themes.
 *
 * Accessibility: every link is at least a 44x44px touch target and carries an
 * `aria-label` (the glyph itself is decorative). http(s) links open in a new tab
 * with `rel="noopener noreferrer"`; `mailto:` links stay in-page.
 */
interface Props {
  /** When true, only show socials flagged `navbar === true`. */
  filterNavbar?: boolean;
  class?: string;
}

const { filterNavbar = false, class: className } = Astro.props;

const socials = filterNavbar
  ? profile.socials.filter((s) => s.navbar)
  : profile.socials;

const isExternal = (url: string) => /^https?:\/\//.test(url);

/** Picks a glyph from the social name; unknown names fall back to a globe. */
const iconFor = (name: string): IconName => {
  const n = name.toLowerCase();
  if (n.includes('github')) return 'github';
  if (n.includes('linkedin')) return 'linkedin';
  if (n.includes('mail') || n.includes('email')) return 'mail';
  if (n.includes('blog') || n.includes('hashnode')) return 'pen';
  return 'globe';
};
---

<ul class:list={['flex flex-wrap items-center gap-1', className]} role="list">
  {
    socials.map((social) => {
      const external = isExternal(social.url);
      return (
        <li>
          <a
            class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-foreground/5 hover:text-foreground focus-visible:text-foreground"
            href={social.url}
            aria-label={social.name}
            title={social.name}
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <Icon name={iconFor(social.name)} size={20} />
          </a>
        </li>
      );
    })
  }
</ul>
