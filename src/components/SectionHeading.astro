---
/**
 * SectionHeading.astro — the shared `<h2>` for every page section.
 *
 * Centralizes the heading type scale and the small accent rule so sections stay
 * visually consistent and there is one place to retune the rhythm.
 *
 * There is deliberately no kicker/eyebrow line. Each one restated its heading in
 * more words ("Where I've worked" above "Experience"), which is noise for both
 * sighted readers and screen readers, and it pushed the real heading down the
 * page. The heading carries the section on its own.
 *
 * The heading `id` is what each section's `aria-labelledby` points at, so it is
 * required rather than derived, keeping the association explicit at the call
 * site.
 */
interface Props {
  /** Element id, referenced by the section's `aria-labelledby`. */
  id: string;
  /** Centers the heading block. */
  center?: boolean;
  class?: string;
}

const { id, center = false, class: className } = Astro.props;
---

<div class:list={['mb-6', center && 'text-center', className]}>
  <h2
    id={id}
    class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl"
  >
    <slot />
  </h2>
  {/* Short accent rule: a purely decorative anchor under each heading, drawn
      left-to-right when the heading scrolls into view (see the script below). */}
  <span
    aria-hidden="true"
    data-heading-rule
    class:list={[
      'mt-3 block h-1 w-16 rounded-full bg-gradient-to-r from-primary to-accent',
      center && 'mx-auto',
    ]}
  />
</div>

<style>
  /* The rule ships at full width. The pre-draw state is applied only by the
     script below, and only once it has confirmed motion is allowed and the
     observer is live, so a no-JS or reduced-motion visitor never sees a
     collapsed rule. Both states are attribute-driven, so the transition is
     declared only on elements the script has actually taken over. */
  [data-heading-rule][data-rule-state] {
    transform-origin: left center;
    will-change: transform;
  }

  /* Collapsing is instant (`transition: none`): a heading already on screen when
     the script runs would otherwise be seen un-drawing itself before redrawing. */
  [data-heading-rule][data-rule-state='pending'] {
    transform: scaleX(0);
    transition: none;
  }

  /* Only the draw is animated, so the wipe plays in one direction. */
  [data-heading-rule][data-rule-state='drawn'] {
    transform: scaleX(1);
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  // Draws each section rule left-to-right as its heading enters the viewport,
  // once per page load.
  //
  // This runs once for the whole page, not once per heading: Astro hoists and
  // de-duplicates component scripts, so a single module handles every instance.
  //
  // Deliberately not routed through the shared AnimationEngine: that facade's
  // reveal is an opacity/translate entrance that ends by committing inline
  // `transform: none`, which would fight a scaleX wipe. This is a two-state CSS
  // transition on a decorative element instead.
  //
  // Failure behaviour matches the rest of the site: any missing API or thrown
  // error leaves (or puts) every rule in its final full-width state.
  const REVEAL_THRESHOLD = 0.6;
  const REVEAL_ROOT_MARGIN = '0px 0px -8% 0px';

  if (typeof window !== 'undefined') {
    const rules = Array.from(
      document.querySelectorAll<HTMLElement>('[data-heading-rule]'),
    );

    const prefersReducedMotion =
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const drawAll = () => {
      for (const rule of rules) rule.dataset.ruleState = 'drawn';
    };

    if (prefersReducedMotion) {
      // Leave the markup untouched: the rules are already full width.
    } else if (typeof IntersectionObserver === 'undefined') {
      // No observer: nothing to collapse, so the rules simply stay drawn.
    } else {
      try {
        for (const rule of rules) rule.dataset.ruleState = 'pending';

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              observer.unobserve(entry.target);
              (entry.target as HTMLElement).dataset.ruleState = 'drawn';
            }
          },
          { threshold: REVEAL_THRESHOLD, rootMargin: REVEAL_ROOT_MARGIN },
        );

        for (const rule of rules) observer.observe(rule);
      } catch (error) {
        console.warn('[SectionHeading] rule reveal failed; showing rules', error);
        drawAll();
      }
    }
  }
</script>
