---
import { about } from '../content/about';
import Icon from './Icon.astro';

/**
 * AboutSection.astro — the About section body.
 *
 * Renders the section body only; the enclosing `<section id="about">` landmark
 * and its `<h2>` come from the page composition in `index.astro`. Every
 * body-only section component in this folder follows the same convention, so
 * each landmark and heading id appears exactly once on the page.
 */
const { paragraphs, currently } = about;
---

<div class="mt-6 space-y-6" data-reveal>
  <div class="space-y-4">
    {
      paragraphs.map((paragraph) => (
        <p class="text-base leading-relaxed text-muted-foreground">{paragraph}</p>
      ))
    }
  </div>

  {
    currently.length > 0 && (
      <div class="glass rounded-xl p-4 sm:p-5">
        <h3 class="mb-3 flex items-center gap-2 text-sm font-semibold text-foreground">
          <Icon name="sparkle" size={16} class="text-primary" />
          Right now
        </h3>
        <ul class="space-y-2" role="list">
          {currently.map((item) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
              <span
                aria-hidden="true"
                class="mt-[0.45rem] block h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
              />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
