---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookShelf from '../../components/site/BookShelf.astro';
import PageTitle from '../../components/site/PageTitle.astro';
import { absoluteUrl } from '../../config/site';
import { getBooks } from '../../lib/books';
import { bookListNode, personNode, webPageNode, websiteNode } from '../../lib/seo/schema';

/**
 * Reads: books I've read and am reading, each with a short note and a link to
 * its own page. To add a book, add a Markdown file to `src/content/books/`.
 */
const books = await getBooks();
const description =
  'Books Rajat Khirid is reading and has read, with a short note on each and a page of his own writing about them.';
---

<BaseLayout
  section="reads"
  title="Reads"
  description={description}
  jsonLd={[
    websiteNode(),
    personNode(),
    webPageNode({
      path: '/reads/',
      name: 'Reads',
      description,
      type: 'CollectionPage',
      mainEntity: { '@id': `${absoluteUrl('/reads/')}#books` },
    }),
    bookListNode(books, '/reads/'),
  ]}
>
  <PageTitle title="Reads">
    <p class="text-center text-muted">
      What I&rsquo;m reading and what I&rsquo;ve finished, with a note on each. What&rsquo;s on the nightstand this
      month is also on the <a href="/now/" class="link">now page</a>.
    </p>
  </PageTitle>

  <div class="mt-10">
    <BookShelf books={books} />
  </div>
</BaseLayout>
