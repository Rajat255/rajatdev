---
import Layout from '../layouts/Layout.astro';
import BackgroundFX from '../components/BackgroundFX.astro';
import Navigation from '../components/Navigation.tsx';
import StatCounters from '../components/StatCounters.tsx';
import Avatar from '../components/Avatar.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialLinks from '../components/SocialLinks.astro';
import AboutSection from '../components/AboutSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import CertificationsSection from '../components/CertificationsSection.astro';
// AchievementsSection is intentionally not imported: that section is hidden for
// now (see the commented block below).
import TimelineSection from '../components/TimelineSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { profile } from '../content/profile';

/**
 * Page composition — a single centered column of sections beneath a compact hero.
 *
 * Above-the-fold content (name, role, tagline, nav targets) is server-rendered so
 * first paint never depends on island hydration.
 *
 * Section ownership: this page owns every `<section>` landmark and its `<h2>`
 * (via SectionHeading); the imported section components render body content only.
 * That keeps each landmark id and heading id appearing exactly once, and means
 * the nav targets in `content/navigation.ts` always resolve.
 *
 * Section order is deliberate: who I am, what I know, where I've worked, what
 * I've built, what I've earned, then the story and the way to reach me.
 */
const sectionClass = 'mx-auto max-w-3xl scroll-mt-24 px-4 py-10';
---

<Layout>
  <a
    href="#content"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-foreground focus:px-4 focus:py-2 focus:font-semibold focus:text-background"
  >
    Skip to content
  </a>

  {/* Fixed, interactive backdrop. Sits behind all content and does not scroll. */}
  <BackgroundFX />

  {/*
    The Navigation island owns its own fixed positioning (a bottom-centered
    floating dock), so the header is a `display: contents` landmark that adds no
    box, never reserves an empty top bar, and cannot introduce horizontal scroll.

    Hydrated with `client:idle` rather than `client:load` to keep the React
    runtime off the critical path: the dock server-renders as real anchors with
    real hrefs, so navigation works before (and without) hydration. Hydration
    only adds the pointer magnification, the smooth-scroll behaviour, and the
    theme toggle.
  */}
  <header class="contents">
    <Navigation client:idle />
  </header>

  {/* `relative z-10` lifts all content above the fixed BackgroundFX layer.
      Bottom padding keeps the last section clear of the fixed dock. */}
  <main id="content" class="relative z-10 pb-32 md:pb-36">
    {/* Hero — not a nav target. A compact intro: text block plus avatar, stacking
        on mobile, with the social row beneath. */}
    {/* The hero no longer carries its own gradient wash; BackgroundFX provides
        the ambient light for the whole page. */}
    {/* Fills one viewport (`svh`, so mobile browser chrome cannot clip it) with
        its content vertically centered, so the greeting lands mid-screen on load
        instead of hugging the top. Bottom padding exceeds top padding on purpose:
        it lifts the block slightly above the geometric centre, which reads as
        centred once the floating dock's visual weight at the bottom is accounted
        for. `min-h` rather than `h`: on short or narrow viewports the hero grows
        with its content instead of overlapping what follows. */}
    <section
      id="hero"
      aria-labelledby="hero-heading"
      class="relative mx-auto flex min-h-[100svh] max-w-3xl flex-col justify-center px-4 pb-32 pt-16"
    >
      <div
        class="flex flex-col items-center gap-8 sm:flex-row sm:items-center sm:justify-between sm:gap-10"
      >
        <div class="order-2 min-w-0 text-center sm:order-1 sm:text-left">
          <h1
            id="hero-heading"
            class="text-4xl font-bold tracking-tight text-foreground md:text-5xl"
          >
            Hi, I'm <span class="text-gradient">Rajat</span>
            <span aria-hidden="true">👋</span>
          </h1>
          <p class="mt-2 text-base font-medium text-primary md:text-lg">
            {profile.role}
          </p>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-muted-foreground md:text-lg">
            {profile.description}
          </p>

          <div
            class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 text-sm text-muted-foreground sm:justify-start"
          >
            <span class="flex items-center gap-1.5">
              <Icon name="pin" size={16} />
              <span>{profile.location}</span>
            </span>
            <a
              class="flex items-center gap-1.5 transition-colors hover:text-foreground"
              href={profile.resumeUrl}
              download
            >
              <Icon name="download" size={16} />
              <span>Resume</span>
            </a>
          </div>

          <div class="mt-3 flex justify-center sm:justify-start">
            <SocialLinks filterNavbar />
          </div>
        </div>

        <div class="order-1 sm:order-2">
          <Avatar
            src={profile.avatarUrl}
            alt={profile.name}
            initials={profile.initials}
            size={140}
            eager
          />
        </div>
      </div>

      {/*
        Scroll cue. A full-height hero hides the fact that the page continues,
        so this is the affordance: a real anchor to the first section (works
        without JS, keyboard reachable, and named for screen readers).

        Absolutely positioned so it cannot shift the centred content above it,
        and sat high enough to stay clear of the fixed dock at every breakpoint.
        `hidden` under `sm` because on a phone the hero content plus the dock
        already fill the screen and the flick-to-scroll instinct is a given.
      */}
      <a
        href="#about"
        aria-label="Scroll to the About section"
        class="scroll-cue-bob absolute bottom-28 left-1/2 hidden -translate-x-1/2 rounded-full p-2 text-muted-foreground transition-colors hover:text-foreground sm:block md:bottom-32"
      >
        <Icon name="chevron-down" size={22} />
      </a>
    </section>

    <section id="about" aria-labelledby="about-heading" class={sectionClass}>
      <SectionHeading id="about-heading">About</SectionHeading>
      <AboutSection />
    </section>

    <section id="skills" aria-labelledby="skills-heading" class={sectionClass}>
      <SectionHeading id="skills-heading">Skills</SectionHeading>
      <SkillsSection />
    </section>

    {/* Experience leads with the animated stat counters. They hydrate on scroll
        (client:visible), and the final values are server-rendered so no-JS
        visitors and screen readers get the real numbers. */}
    <section id="experience" aria-labelledby="experience-heading" class={sectionClass}>
      <SectionHeading id="experience-heading">Experience</SectionHeading>
      <StatCounters client:visible />
      <ExperienceSection />
    </section>

    <section id="projects" aria-labelledby="projects-heading" class={sectionClass}>
      <SectionHeading id="projects-heading">Projects</SectionHeading>
      <ProjectsSection />
    </section>

    <section
      id="certifications"
      aria-labelledby="certifications-heading"
      class={sectionClass}
    >
      <SectionHeading id="certifications-heading">Certifications</SectionHeading>
      <CertificationsSection />
    </section>

    {/*
      Achievements is hidden for now. Content (`content/achievements.ts`) and the
      section component both remain; to bring it back, un-comment this block and
      restore 'achievements' in the `SectionId` enum in `content/navigation.ts`,
      which is what the section-presence tests read.

      <section id="achievements" aria-labelledby="achievements-heading" class={sectionClass}>
        <SectionHeading id="achievements-heading">Achievements</SectionHeading>
        <AchievementsSection />
      </section>
    */}

    <section id="timeline" aria-labelledby="timeline-heading" class={sectionClass}>
      <SectionHeading id="timeline-heading">Timeline</SectionHeading>
      <TimelineSection />
    </section>

    {/* Extra top margin sets contact apart as the closing section. */}
    <section
      id="contact"
      aria-labelledby="contact-heading"
      class="mx-auto mt-16 max-w-3xl scroll-mt-24 px-4 pb-10 pt-10 md:mt-24"
    >
      <SectionHeading id="contact-heading" center>Get in Touch</SectionHeading>
      <ContactSection />
    </section>
  </main>

  {/* Footer. Also carries the background shader's required attribution: the
      "Auroras" fragment shader is CC BY-NC-SA 3.0 by nimitz, which obliges us to
      credit the author and name the licence wherever the work is used. */}
  <footer
    class="relative z-10 mx-auto max-w-3xl px-4 pb-28 pt-8 text-center text-xs text-muted-foreground md:pb-32"
  >
    <p>© {new Date().getFullYear()} {profile.name}</p>
  </footer>
</Layout>
