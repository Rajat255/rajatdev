---
import BaseLayout from '../layouts/BaseLayout.astro';
import BirdDivider from '../components/ornaments/BirdDivider.astro';
import DropCap from '../components/ornaments/DropCap.astro';
import Woodcut from '../components/ornaments/Woodcut.astro';
import NoteList from '../components/site/NoteList.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import { SITE_CONFIG } from '../config/site';
import { getPublishedNotes } from '../lib/notes';
import { personNode, profilePageNode, websiteNode } from '../lib/seo/schema';

/**
 * The front page: one quiet column. An engraving, the title, a short hello,
 * the latest notes, and links to where everything else lives.
 *
 * Title colours use the `accent` and `ink` tokens rather than raw hex: in the
 * light theme they are exactly #9E2A2B and #161514, and they stay legible
 * when dark mode swaps the palette.
 */
const latest = (await getPublishedNotes()).slice(0, 4);
const { email } = SITE_CONFIG.contact;

const elsewhere = [
  {
    label: 'Builds & Work',
    href: '/builds/',
    note: 'Cloud engineering at amber, FinOps case studies ($200K/yr saved), autonomous CI/CD agents, and live homelab telemetry.',
  },
  {
    label: 'Threads & Books',
    href: '/threads/',
    // Authored HTML (not user input), so the book titles can be set in italics.
    note: 'Reading notes (<cite>Trust</cite>, <cite lang="fr">L’Étranger</cite>, <cite>A Thousand Splendid Suns</cite>, <cite lang="fr">Le Petit Prince</cite>), photography, and ongoing rabbit holes.',
  },
  {
    label: 'Colophon & Feeds',
    href: '/colophon/',
    note: 'How this site is built, self-hosted in Pune, the <a href="/rss.xml" class="link">RSS feed</a>, and the machine-readable <a href="/llms.txt" class="link">/llms.txt</a>.',
  },
];
---

<BaseLayout
  section="home"
  width="narrow"
  ogType="profile"
  jsonLd={[
    websiteNode(),
    personNode(),
    profilePageNode('/', SITE_CONFIG.title, SITE_CONFIG.description),
  ]}
>
  <div class="pt-4 text-center sm:pt-8">
    <Woodcut class="mx-auto mb-6 h-32 w-32" />

    <h1 class="font-serif font-semibold uppercase leading-tight">
      <span class="block pl-[0.16em] text-4xl font-bold tracking-[0.16em] text-accent sm:text-5xl">From Rajat</span>
      <span class="mt-2 block pl-[0.2em] text-2xl font-semibold tracking-[0.2em] text-ink sm:text-3xl">
        Builds &amp; Threads
      </span>
      <span class="mt-1.5 block pl-[0.2em] text-lg font-semibold tracking-[0.2em] text-ink sm:text-xl">
        Things I&rsquo;ve Made
      </span>
      <span class="mt-1 block pl-[0.2em] text-base font-semibold tracking-[0.2em] text-ink sm:text-lg">
        And Books I&rsquo;ve Read
      </span>
    </h1>

    <p
      class="my-7 inline-block border-y border-ink/70 px-6 py-2 pl-[calc(1.5rem+0.18em)] text-xs font-semibold uppercase tracking-[0.18em] sm:text-sm"
    >
      Written by: Rajat Khirid
    </p>

    <figure class="text-muted">
      <p class="text-sm tracking-[0.3em] text-accent" role="img" aria-label="Five stars">⭑ ⭑ ⭑ ⭑ ⭑</p>
      <blockquote class="mt-1 italic">&ldquo;Another infrastructure nerd trying to make production boring.&rdquo;</blockquote>
    </figure>
  </div>

  <div class="mx-auto mt-12 max-w-[580px]">
    <p>
      <DropCap letter="H" />
      <span class="sr-only">H</span>ey, I&rsquo;m Rajat. Welcome to my corner of the web. By day, I&rsquo;m a Cloud and
      DevOps engineer in Pune scaling production systems on AWS and Kubernetes—taking messy infrastructure and making it
      reproducible, observable, and quiet. By night, I&rsquo;m usually reading, learning French, riding my motorbike
      down the coast, or tinkering on the bare-metal homelab serving you this page.
    </p>
    <p class="mt-5">
      Feel free to poke around the <a href="/builds/" class="link">things I&rsquo;ve built</a>, read through my
      <a href="/notes/" class="link">notes &amp; essays</a>, browse the
      <a href="/threads/" class="link">books &amp; threads</a> on my nightstand, or
      <a href={`mailto:${email}`} class="link">send me an email</a>. I&rsquo;m glad you&rsquo;re here.
    </p>
  </div>

  <BirdDivider class="my-12" />

  <section aria-labelledby="latest-heading">
    <SectionHeading id="latest-heading">Latest notes</SectionHeading>
    <div class="mt-8">
      {
        latest.length > 0 ? (
          <NoteList notes={latest} />
        ) : (
          <p class="text-center italic text-muted">Nothing written yet. Check back soon.</p>
        )
      }
    </div>
    <p class="mt-6 text-center text-base">
      <a href="/notes/" class="link text-muted">All notes →</a>
    </p>
  </section>

  <section aria-labelledby="elsewhere-heading" class="mt-16">
    <SectionHeading id="elsewhere-heading">Elsewhere on this site</SectionHeading>
    <ul class="mt-8 space-y-4" role="list">
      {
        elsewhere.map((item) => (
          <li>
            <a href={item.href} class="link font-semibold text-ink">{item.label}</a>
            <span class="text-muted">
              — <Fragment set:html={item.note} />
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
