---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BirdDivider from '../../components/ornaments/BirdDivider.astro';
import { absoluteUrl } from '../../config/site';
import { getPublishedNotes, noteHref, noteMarkdownHref, noteStats, type Note } from '../../lib/notes';
import { formatLongDate, toIsoDate } from '../../lib/format';
import { blogPostingNode, personNode, websiteNode } from '../../lib/seo/schema';

/**
 * A single note, set like a page in a book: a centred title, the date, reading
 * time and word count, a drop cap on the opening paragraph, and Tailwind
 * Typography (`prose-stone`, recoloured to the site's tokens) for the body.
 */
export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note, index) => ({
    params: { slug: note.slug },
    props: {
      note,
      // Sorted newest first, so the next-newer note sits one index earlier.
      newer: notes[index - 1] ?? null,
      older: notes[index + 1] ?? null,
    },
  }));
}

interface Props {
  note: Note;
  newer: Note | null;
  older: Note | null;
}

const { note, newer, older } = Astro.props;
const { Content } = await note.render();
const { title, description, pubDate, updatedDate, category, tags, canonicalUrl } = note.data;
const stats = noteStats(note);
const markdownHref = noteMarkdownHref(note);
---

<BaseLayout
  section="threads"
  title={title}
  description={description}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
  canonical={canonicalUrl ?? absoluteUrl(noteHref(note))}
  alternates={[{ type: 'text/markdown', href: markdownHref, title: `${title} (Markdown)` }]}
  jsonLd={[websiteNode(), personNode(), blogPostingNode(note, stats)]}
>
  <article class="pt-14 sm:pt-20">
    <header class="text-center">
      <p class="smallcaps text-accent">{category}</p>
      <h1 class="mt-3 text-[2rem] font-semibold leading-[1.15] text-ink sm:text-[2.5rem]">{title}</h1>
      <p class="mx-auto mt-4 max-w-[34rem] italic leading-snug text-muted">{description}</p>
      <p class="mt-6 text-base text-muted">
        <time datetime={toIsoDate(pubDate)}>{formatLongDate(pubDate)}</time>
        <span aria-hidden="true"> · </span>
        {stats.minutes} min read
        <span aria-hidden="true"> · </span>
        {stats.words.toLocaleString('en-US')} words
        {
          updatedDate && (
            <>
              <span aria-hidden="true"> · </span>
              updated <time datetime={toIsoDate(updatedDate)}>{formatLongDate(updatedDate)}</time>
            </>
          )
        }
      </p>
      <p class="mt-1 text-base">
        <a href={markdownHref} class="link text-muted">View raw Markdown</a>
      </p>
    </header>

    <BirdDivider class="my-10" />

    <div class="prose prose-lg prose-stone drop-cap max-w-none font-serif sm:prose-xl">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <p class="mt-10 text-base text-muted">
          <span class="smallcaps">Filed under</span> {tags.join(', ')}
        </p>
      )
    }
  </article>

  <nav aria-label="More posts" class="mt-12 border-t border-rule pt-6">
    <ul class="grid gap-6 sm:grid-cols-2" role="list">
      <li>
        {
          older && (
            <>
              <span class="smallcaps block text-muted">Previously</span>
              <a href={noteHref(older)} class="link leading-snug">
                {older.data.title}
              </a>
            </>
          )
        }
      </li>
      <li class="sm:text-right">
        {
          newer && (
            <>
              <span class="smallcaps block text-muted">Next</span>
              <a href={noteHref(newer)} class="link leading-snug">
                {newer.data.title}
              </a>
            </>
          )
        }
      </li>
    </ul>
    <p class="mt-8 text-center">
      <a href="/threads/" class="link text-muted">← Back to all threads</a>
    </p>
  </nav>
</BaseLayout>
