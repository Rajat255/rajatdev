---
import { getPublishedNotes, noteHref } from '../../lib/notes';

/**
 * /notes/<slug>/ — old post URLs, from before posts moved to /threads. Each
 * one is a tiny page that sends the reader (and search engines, via the
 * canonical link and noindex) to the post's new home.
 */
export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note) => ({ params: { slug: note.slug }, props: { target: noteHref(note) } }));
}

interface Props {
  target: string;
}

const { target } = Astro.props;
const absolute = new URL(target, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Moved</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={absolute} />
  </head>
  <body>
    <p>This post has moved to <a href={target}>{absolute}</a>.</p>
  </body>
</html>
